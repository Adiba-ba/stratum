# Local credentials. Copy to .env and fill in. .env is gitignored.

# OpenSky Network (OAuth2 client credentials)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# EUMETSAT Data Store
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
EUMETSAT_API_TOKEN=

# ECMWF CDS (optional; ~/.cdsapirc is read when these are unset)
CDSAPI_URL=
CDSAPI_KEY=
